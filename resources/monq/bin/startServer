#!/bin/bash
########################################################################
#
# Start one of our filter servers as described by a config file in
# $MONQ/config/*.svr
#
# (C) 2006 Harald Kirsch
########################################################################
#
me="${0##*/}"
machine="dell"
. $MONQ/bin/setup.sh

cfg="$MONQ/config"
log="$MONQ/logging"
machine=$(hostname | cut -d . -f 1)

if [ "$#" != 1 -o "${1:0:1}" = "-" ]; then
  echo 1>&2 usage: $me svr
  echo 1>&2 "  svr - name of a server with a config file in $cfg"
  echo 1>&2 "Will first try to check if the server is already running."
  exit 1
fi
svr="$1"

########################################################################
# Try a connect to a given host and port; return true if it works
function ping() {
  local host="$1"
  local port="$2"
  true </dev/tcp/${host}/${port} || false
}
########################################################################
# given an XML tag and a string, fetch the first XML element within
# the string with that tag. If the element does not exist in the
# string, an empty string is returned.
# Attributes are not supported!
function listFirst() {
  local tag="$1"
  local l="$2"
  x="${l%%</${tag}>*}"
  if [ "$x" = "$l" ]; then
    echo ""
    return 0
  fi
  x="${x##*<$tag>}"
  echo "$x" | sed -e 's/&lt;/</g' -e 's/&gt;/>/g' -e 's/&amp;/\&/g'
}
########################################################################
# Dual function for listFirst above
function listRest() {
  echo "${2#*</$1>}"
}
########################################################################
# MAIN

# read the config file: 
# Within the <cmd> tag, newline is translated to space, because we
# want only exactly one command there, not a script

config=$(Grep :: -co -cr -r '<cmd>' '</cmd>' '[\\\\]?\n' ' ' <"${cfg}/${svr}.svr")

cmd=$(listFirst cmd "$config")
port=$(listFirst port "$config")
host=$(listFirst host "$config")

if [ "$host" != "$machine" ]; then
  #echo 1>&2 $me: ${svr} must be started on machine ${host}
  echo "$me: logging into ${host} to launch the server"
  ssh $host $(which ${me}) ${svr}
  exit 1
fi

# read key value pairs for the environment and set them up as strings
# for the command
cmdenv=""
envPairs=$(listFirst environment "$config")
key=$(listFirst key "$envPairs")
while ! [ -z "$key" ]; do 
  envPairs=$(listRest key "$envPairs")
  value=$(listFirst value "$envPairs")
  envPairs=$(listRest value "$envPairs")
  cmdenv="${cmdenv} $key=\"$value\""
  key=$(listFirst key "$envPairs")
done

logfile="${log}/${svr}.log"

# If there is a logfile available, then get the host and port reported
# there and see if this server is still listening. If so, ask if the
# server should be started anyway. We want to make sure that at least
# a renamed logfile is kept iff there is a server still running.
if [ -f "$logfile" ]; then
  a=($(head -1 $logfile))
  if ping "${a[2]}" "${a[3]}" 1>/dev/null 2>/dev/null; then
    if [ "${a[2]}:${a[3]}" = "${host}:${port}" ]; then
      b=($(/sbin/fuser $logfile))
      test "${#b[@]}" -eq 2 && txt=" pid is ${b[1]}."
      echo "${me}: ${svr} already running on ${a[2]}:${a[3]}. ${txt}"
      test "${#b[@]}" -ne 2 && exit
      pid="${b[1]}"
      echo
      ps -o cmd -wwww -p $pid | tail +2
      echo -en "\nKill ${pid}? [y/N] "
      read x
      if [ "$x" != "y" ]; then echo "-- bye."; exit; fi
      while kill -9 ${pid} 2>/dev/null; do 
        echo "send KILL signal to $pid on $(hostname)"
	sleep 1
      done
      olog="${logfile%%.log}.olog"
      rm -f "$olog"
      mv "$logfile" "$olog"
      echo "process killed, logfile renamed to $olog"
      exit
    else
      echo "The server ${svr} is currently running on ${a[2]}:${a[3]}."
      echo -n "Rename the logfile and restart anyway? [y/n] "
      read x
      if [ "$x" != "y" ]; then echo "-- bye."; exit; fi
      i=1
      while [ -f "${logfile}.`printf %03d $i`" ]; do i=$((i+1)); done
      mv $logfile "${logfile}.`printf %03d $i`"
    fi
  else
    msg=""
    if ! grep 'startup.*TcpServer' "$logfile"; then
      msg="NOTE: the server may be in its startup phase."
    fi
    echo "There exists a logfile for ${svr} but nobody seems to listen on"
    echo "${a[2]}:${a[3]}. $msg"
    echo -n "Delete the logfile and continue? [y/N] "
    read x
    if [ "$x" != "y" ]; then echo "-- bye."; exit; fi
    rm -f $logfile
  fi
fi

if ping "$host" "$port" 1>/dev/null 2>/dev/null; then
  echo 1>&2 ${me}: ${host}:${port} seems to be in use
  exit 1
fi

## This one is neat: Close stdin of this script, copy file descriptor
## for stdout to descriptor no. 3 for later use, then redirect stdout
## and stderr to the logfile.
exec 0<&- 3>&1 >"$logfile" 2>&1

## Make sure nobody accidently deletes the logfile. Its first line is
## our best clue where to find this server if it is still running.
chmod 444 "${logfile}"

## Leave another hint that this is a pipeline server in the
## environment of the command. Sadly, however, this can only be seen
## by root or by the process owner
export PIPESVR="${svr}_${port}"

echo starting ${svr}: ${host} $port
echo '<env>'
env | awk '{print " ", $0}'
echo '</env>'

echo "$cmdenv exec $cmd &"
echo "Starting ${svr} on ${port}, logfile is ${logfile} ." 1>&3

# Close our last console connection to make sure ssh does not hang.
exec 3>&-
eval "$cmdenv $cmd &" 


